# Copy to .env (local) or add each line to Replit Secrets. Never commit real values.

# PostgreSQL connection string (Replit PostgreSQL provides this automatically)
DATABASE_URL=postgresql://user:pass@localhost:5432/tepat

# Two different 4-digit PINs: owner and manager (the manager PIN is read from STAFF_PIN)
OWNER_PIN=
STAFF_PIN=

# 32+ random characters; signs the session cookie
SESSION_SECRET=

# Google AI Studio key for Gemini document reads (the demo still runs from cached sample reads without it)
GEMINI_API_KEY=

# Demo mode: sample documents, "demo read" fallback, demo reset, seed an empty database
DEMO_FIXTURES=1
SEED_ON_BOOT=1

# Optional
# STORAGE_DRIVER=disk            # local runs; Replit App Storage is used automatically on Replit
# PUBLIC_BASE_URL=https://your-app.replit.app   # public URL used in evidence links
# PORT=5000
# Do NOT set NODE_ENV as a secret: the start script sets it.
