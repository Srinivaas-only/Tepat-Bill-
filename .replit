modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[objectStorage]
defaultBucketID = "replit-objstore-ae27597d-addd-4e8c-bde3-1c495b5ff139"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80




[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "npm run db:push && npm run start"]
build = ["npm", "run", "build"]
